# ============================================================
# T2T Admin Panel — Environment Variables Template
# ============================================================

# 1. DATABASE
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 2. SUPABASE
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 3. EMAIL PROVIDER CONFIGURATION
# Options: resend | brevo | sendgrid | ses | postmark | smtp
EMAIL_PROVIDER="resend"
EMAIL_FALLBACK_PROVIDER=""

# Resend Credentials
RESEND_API_KEY="re_123456789"

# Organization Sender Addresses (Generic / Non-Personal)
EMAIL_FROM_EMAIL="noreply@trash2treasure.co.in"
EMAIL_FROM_NAME="Trash2Treasure"
EMAIL_REPLY_TO="support@trash2treasure.co.in"
SUPPORT_EMAIL="support@trash2treasure.co.in"
ADMIN_NOTIFICATIONS_EMAIL="admin@trash2treasure.co.in"
TEST_EMAIL=""

# Supabase Auth Send Email Hook Secret (Optional security token)
SUPABASE_AUTH_HOOK_SECRET=""

# 4. APPLICATION CONFIG
NEXT_PUBLIC_APP_URL="https://admin.trash2treasure.co.in"
NODE_ENV="development"
